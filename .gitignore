# Resultados de las simulaciones: no se versionan, se regeneran con los scripts
simulaciones/*/md_*/
simulaciones/*/analisis*/
simulaciones/*/resultados*/
*.dcd
*.nc
*.chk
corrida*.log
nohup.out

# Python
__pycache__/
*.pyc
*.egg-info/

# Prefijos de micromamba creados por error dentro del proyecto
simulaciones/*/y/

# LaTeX (si se agrega el reporte en la raíz)
/*.aux
/*.fdb_latexmk
/*.fls
/*.out
/*.synctex.gz
*.swp

# dmlrun: registro local de ejecuciones, informes y corridas nuevas
/resultados/
.dmlrun/
reportes/
*/*/runs/
.vista/

# LaTeX del reporte (paper/): se versiona el .tex y las figuras, no lo generado
paper/*.aux
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/*.bak
paper/simulacion.pdf
